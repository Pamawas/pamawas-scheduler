# Database
DATABASE_URL=postgres://pamawas:pamawas@localhost:5432/pamawas?sslmode=disable

# Server
PORT=8080
LOG_LEVEL=info
ENVIRONMENT=development

# Scheduler
REPORTER_URL=http://localhost:8081
DAILY_REPORT_TIME=07:00
HIGH_SEVERITY_THRESHOLD=high
CHECK_INTERVAL=30s
ENABLE_DAILY_REPORT=true
ENABLE_HIGH_SEVERITY_ALERT=true
SCHEDULER_MODE=auto